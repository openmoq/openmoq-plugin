# libmoq (openmoq/moq5) revision this plugin builds against.
#
# Read by .github/scripts/build-libmoq. MOQ5_REF may be a commit SHA or a
# branch/tag name; either way the CI cache is keyed on the SHA it resolves
# to, so a moving branch still triggers a rebuild.
#
# The plugin needs the CMAF packager, which is not in openmoq/moq5 main yet
# (proposed as openmoq/moq5#12). It tracks that PR's merge ref, i.e. the PR on
# top of current main, so fixes already on main (such as HEVC temporal
# sub-layers) are kept. Switch to main once the PR lands.
MOQ5_REPO=https://github.com/openmoq/moq5.git
MOQ5_REF=refs/pull/12/merge
